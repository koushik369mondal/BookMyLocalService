generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  phone       String   @unique
  password    String
  role        UserRole @default(CUSTOMER)
  avatar      String?
  isVerified  Boolean  @default(false)
  address     String?
  city        String?
  state       String?
  zipCode     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}