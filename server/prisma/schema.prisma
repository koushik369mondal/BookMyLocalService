generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceStatus {
  NOT_STARTED
  ONGOING
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH_ON_JOB
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

model User {
  id                 String        @id @default(cuid())
  fullName           String
  email              String        @unique
  phone              String?
  password           String?
  role               UserRole      @default(CUSTOMER)
  avatar             String?
  isVerified         Boolean       @default(false)
  address            String?
  city               String?
  state              String?
  zipCode            String?
  otpHash            String?
  otpExpiresAt       DateTime?
  otpAttempts        Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  services           Service[]
  customerBookings   Booking[]     @relation("CustomerBookings")
  providerBookings   Booking[]     @relation("ProviderBookings")
  collectedPayments  Booking[]     @relation("CollectedPayments")
  customerReviews    Review[]      @relation("CustomerReviews")
  providerReviews    Review[]      @relation("ProviderReviews")
  availabilityConfig Availability?
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  imageUrl    String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]
}

model Service {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  description  String
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  providerId   String
  provider     User      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  location     String
  price        Float
  priceType    String
  rating       Float     @default(5.0)
  reviewCount  Int       @default(0)
  availability String
  badge        String?
  imageUrl     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  reviews      Review[]
}

enum ReviewStatus {
  NOT_REVIEWED
  REVIEWED
}

model Booking {
  id            String        @id @default(cuid())
  customerId    String
  customer      User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  providerId    String
  provider      User          @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Cascade)
  plan          String
  date          String
  time          String
  price         Float
  platformFee   Float         @default(4.99)
  tax           Float
  discount      Float         @default(0.0)
  total         Float

  bookingStatus BookingStatus @default(PENDING)
  serviceStatus ServiceStatus @default(NOT_STARTED)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(ONLINE)
  paymentId     String?
  paidAt        DateTime?
  collectedById String?
  collectedBy   User?         @relation("CollectedPayments", fields: [collectedById], references: [id], onDelete: SetNull)

  reviewStatus  ReviewStatus  @default(NOT_REVIEWED)

  status        String        @default("pending")
  
  // Billing details
  billingName   String?
  billingEmail  String?
  billingPhone  String?
  street        String?
  city          String?
  state         String?
  zipCode       String?
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  review        Review?
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String?  @unique
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  providerId String
  provider   User     @relation("ProviderReviews", fields: [providerId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  rating     Float
  title      String?
  comment    String
  reply      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Availability {
  id             String   @id @default(cuid())
  providerId     String   @unique
  provider       User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  weeklySchedule Json
  blockedDates   Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType @default(FIXED)
  discountValue  Float
  minOrderAmount Float        @default(0.0)
  maxDiscount    Float?
  usageLimit     Int?
  usageCount     Int          @default(0)
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}